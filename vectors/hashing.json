 "code_hash": {
  "how": "code_hash(regions) -> hash: regions sorted by (file, start), each normalized by style_of(file), joined with \"\\n\\u0000\\n\", SHA-256 of the UTF-8, first 12 hex digits.",
  "rows": [
   {
    "name": "one region",
    "regions": [
     {
      "file": "src/a.ts",
      "start": 1,
      "lines": [
       "  one();",
       "  two();"
      ]
     }
    ],
    "hash": "ec20c1fb6bf5"
   },
   {
    "name": "two regions of a file are joined in line order, whatever order they are given in",
    "regions": [
     {
      "file": "src/a.ts",
      "start": 20,
      "lines": [
       "two();"
      ]
     },
     {
      "file": "src/a.ts",
      "start": 3,
      "lines": [
       "one();"
      ]
     }
    ],
    "hash": "4fd41aa01443"
   },
   {
    "name": "regions of several files are joined in file order, each by the rule of its type",
    "regions": [
     {
      "file": "src_ts/a.ts",
      "start": 1,
      "lines": [
       "export const A = 1;"
      ]
     },
     {
      "file": "src_py/a.py",
      "start": 1,
      "lines": [
       "def total(items):",
       "    t = 0",
       "    for i in items:",
       "        t += i",
       "    return t"
      ]
     }
    ],
    "hash": "afee56036c1d"
   },
   {
    "name": "the same text in one region or two gives different hashes (the join counts)",
    "regions": [
     {
      "file": "src/a.ts",
      "start": 1,
      "lines": [
       "one();"
      ]
     },
     {
