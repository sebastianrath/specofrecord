#!/bin/sh
# Runs the Spec of Record tool that ships with this plugin: sor status, sor claim <id>, ...
# Follow symlinks, so a link to this file (in /usr/local/bin, say) still finds the tools that sit next to the real one.
self=$0
while [ -h "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case $self in /*) ;; *) self="$dir/$self" ;; esac
done
here=$(cd "$(dirname "$self")" && pwd)
. "$here/sor-python"
if [ -z "$SOR_PY" ]; then
  if [ -n "$SOR_PY_SEEN" ]; then
    echo "sor: Python 3.9 or newer is needed, found $($SOR_PY_SEEN --version 2>&1)" >&2
  else
    echo "sor: Python 3.9 or newer is needed and none (python3, python or py -3) was found on the PATH" >&2
  fi
  exit 127
fi
exec $SOR_PY "$here/../tools/sor.py" "$@"
