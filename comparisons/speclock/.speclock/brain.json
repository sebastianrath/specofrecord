  "decisions": [
    {
      "id": "dec_6c3f9d164630",
      "text": "Plain HTML, CSS and JavaScript in one file; no framework, no build",
      "createdAt": "2026-10-16T09:55:00.000Z",
      "source": "compiler",
      "tags": [
        "architecture"
      ]
    },
    {
      "id": "dec_0872f7203779",
      "text": "Six parts: bodies, clock, camera, scene, controls, selection; one owner per piece of state so agents can work on parts in parallel",
      "createdAt": "2026-10-16T09:56:00.000Z",
      "source": "compiler",
      "tags": [
        "architecture"
      ]
    },
    {
      "id": "dec_56ca436e360c",
      "text": "Nearest center wins for clicks, because at start zoom the moon's click area covers Earth",
      "createdAt": "2026-10-16T09:57:00.000Z",
      "source": "compiler",
      "tags": [
        "selection"
      ]
    },
    {
      "id": "dec_303897c2f4e2",
      "text": "Tests run in headless Chrome against window.__probe; coverage from Chrome's built-in coverage",
      "createdAt": "2026-10-16T09:58:00.000Z",
      "source": "compiler",
      "tags": [
        "tests"
      ]
    },
    {
      "id": "dec_8eb03312e5a7",
      "text": "Cap frame gaps at 0.1 s so a hidden tab does not make the planets jump",
      "createdAt": "2026-10-16T09:59:00.000Z",
      "source": "compiler",
      "tags": [
        "clock"
      ]
    }
  ],
  "notes": [
    {
      "id": "note_3ad09b0a0d9d",
      "text": "Body table (size / orbit / days / color): Mercury 4/60/88/#B1ADA7, Venus 7/90/225/#E8C98A, Earth 7/125/365/#4F8FE6, Mars 5/160/687/#D1623A, Jupiter 16/230/4333/#D9A66C, Saturn 13/300/10759/#E3CF8E, Uranus 10/365/30687/#8FD3D9, Neptune 10/420/60190/#4468D6",
      "createdAt": "2026-10-16T09:59:00.000Z",
      "pinned": true
    },
    {
      "id": "note_536c4f1b0666",
      "text": "One year = Earth's orbit time, 365 days. px are screen pixels and never grow with zoom; space units grow with zoom.",
      "createdAt": "2026-10-16T09:59:00.000Z",
      "pinned": true
    },
    {
      "id": "note_bc7bf04ee90a",
      "text": "Look is a sketch: glow, shading, ring tilt and fonts are the developer's choice. Feel: calm planetarium, nothing jumps or overlaps.",
      "createdAt": "2026-10-16T09:59:00.000Z",
      "pinned": true
    },
    {
      "id": "note_4be0981f76bd",
      "text": "43 acceptance tests are listed in docs/PRD.md (5 manual). Regressions to keep: bug #3 (Space after Pause), first build drew no stars, first build drew flat circles.",
      "createdAt": "2026-10-16T09:59:00.000Z",
      "pinned": true
    }
